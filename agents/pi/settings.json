{
  "compaction": {
    "enabled": true
  },
  "retry": {
    "enabled": true,
    "maxRetries": 50,
    "provider": {
      "maxRetries": 0
    }
  },
  "hideThinkingBlock": true,
  "shellPath": "/bin/zsh",
  "shellCommandPrefix": "fpath=($HOME/Developer/dotfiles/zsh/functions $fpath); autoload -Uz gpr coffee",
  "packages": [
    "git:github.com/HazAT/pi-ghostty",
    "git:github.com/nicobailon/pi-mcp-adapter@v2.8.0",
    "npm:pi-multi-account",
    {
      "source": "npm:pi-claude-bridge@0.8.0",
      "extensions": []
    }
  ],
  "lastChangelogVersion": "0.87.1",
  "theme": "gruvbox-high-contrast",
  "defaultProvider": "claude-bridge",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "high"
}