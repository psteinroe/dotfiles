{
  "storageCleanup": {
    "worktreeAfterDays": 8,
    "worktreeSettledAfterDays": 8,
    "worktreeOnMerge": true,
    "worktreeOnDelete": true,
    "worktreeUnchanged": true,
    "browserArtifactsAfterDays": 8,
    "logsAfterDays": 8
  },
  "enableProviderUpdateChecks": false,
  "defaultModelSelection": {
    "instanceId": "claudeAgent",
    "model": "claude-opus-5-5",
    "options": [
      {
        "id": "effort",
        "value": "high"
      }
    ]
  },
  "projectSettingsFolded": true,
  "deviceOnboardingCompleted": true,
  "defaultThreadEnvMode": "worktree",
  "providerInstances": {
    "codex": {
      "driver": "codex",
      "enabled": true,
      "config": {
        "setupMode": "existing"
      }
    }
  },
  "defaultProjectScripts": [
    {
      "id": "repo-setup",
      "name": "Repo setup",
      "command": "t3-repo-action setup",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "runOnSettle": false
    },
    {
      "id": "repo-settle",
      "name": "Repo settle",
      "command": "t3-repo-action settle",
      "icon": "configure",
      "runOnWorktreeCreate": false,
      "runOnSettle": true
    }
  ]
}
