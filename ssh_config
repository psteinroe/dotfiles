# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

Host exe.dev *.exe.xyz
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_ed25519

# Personal exe.dev VM, over Tailscale. exe.dev's own SSH (exedev@psteinroe-dev.exe.xyz)
# reaches the same VM as another user, so it gets no alias.
Host rdev
  HostName psteinroe-dev.tail6aabd2.ts.net
  User psteinroe
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_ed25519
  ControlMaster auto
  ControlPath ~/.ssh/cm-%r@%h:%p
  ControlPersist 10m

# Work devbox from getmateo/devboxes. Tailscale SSH: no keys, a browser check now and then.
Host devbox-psteinroe
  HostName devbox-psteinroe.tail649856.ts.net
  User psteinroe
  ControlMaster auto
  ControlPath ~/.ssh/cm-%r@%h:%p
  ControlPersist 10m

Host github.com
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519
