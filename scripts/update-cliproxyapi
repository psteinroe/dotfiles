#!/usr/bin/env bash
# Pin nix/nixos/cliproxy/cliproxyapi.nix to a CLIProxyAPI release: the latest one, or the tag given as $1.
set -euo pipefail

cd "$(dirname "$0")/.."
file=nix/nixos/cliproxy/cliproxyapi.nix
repo=router-for-me/CLIProxyAPI

tag=${1:-$(gh release view -R "$repo" --json tagName -q .tagName)}
version=${tag#v}
tarball="CLIProxyAPI_${version}_linux_aarch64_no-plugin.tar.gz"

sum=$(gh release download "$tag" -R "$repo" -p checksums.txt -O - | awk -v f="$tarball" '$2 == f { print $1 }')
[[ -n $sum ]] || { echo "$tag has no $tarball" >&2; exit 1; }
hash=$(nix hash convert --hash-algo sha256 --to sri "$sum")

sed -i.bak -E \
  -e "s/(cliproxyapiVersion = \")[^\"]+/\1$version/" \
  -e "s|(hash = \")sha256-[^\"]+|\1$hash|" \
  "$file"
rm "$file.bak"

echo "cliproxyapi $version ($hash)"
