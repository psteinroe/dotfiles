#!/usr/bin/env bash
# Pin nix/home/t3code.nix to a T3 Code release: the latest stable one, or the tag given as $1.
set -euo pipefail

cd "$(dirname "$0")/.."
file=nix/home/t3code.nix
repo=pingdotgg/t3code

tag=${1:-$(gh release view -R "$repo" --json tagName -q .tagName)}
version=${tag#v}
tarball="t3-$version-linux-x64.tar.gz"

sum=$(gh release download "$tag" -R "$repo" -p SHA256SUMS -O - | awk -v f="$tarball" '$2 == f { print $1 }')
[[ -n $sum ]] || { echo "$tag has no $tarball" >&2; exit 1; }
hash=$(nix hash convert --hash-algo sha256 --to sri "$sum")

sed -i.bak -E \
  -e "s/(t3codeVersion = \")[^\"]+/\1$version/" \
  -e "s|(hash = \")sha256-[^\"]+|\1$hash|" \
  "$file"
rm "$file.bak"

echo "t3code $version ($hash)"
