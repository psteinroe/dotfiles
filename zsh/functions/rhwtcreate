# From Mac: create/ensure a remote Git worktree and focus it in remote Herdr.
# Usage: rhwtcreate <repo> <branch|pr-number>
#
# If the remote Herdr session is not running, prepares and registers it with
# `rdev <repo>` before continuing; no detach or second TUI is required. The
# startup probe runs a bounded live Herdr CLI request through the session.
if [[ $# -ne 2 ]]; then
  echo "Usage: rhwtcreate <repo> <branch|pr-number>" >&2
  return 1
fi

local host="${RDEV_HOST:-rdev}"
local remote_user="${RDEV_REMOTE_USER:-psteinroe}"
local remote_home="${RDEV_HOME:-/home/${remote_user}}"
local remote_path="${remote_home}/.local/bin:${remote_home}/.nix-profile/bin:/nix/var/nix/profiles/default/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
local dotfiles="${RDEV_REMOTE_DOTFILES:-${remote_home}/Developer/dotfiles}"
local repo="${1%.git}"
local requested="$2"
local repo_dir="${remote_home}/Developer/${repo}.git"
local plain_repo_dir="${remote_home}/Developer/${repo}"
local socket_path="${remote_home}/.config/herdr/sessions/${repo}/herdr.sock"
local check_runner="sudo -u ${(q)remote_user} HOME=${(q)remote_home} USER=${(q)remote_user} LOGNAME=${(q)remote_user} PATH=${(q)remote_path} HERDR_SESSION=${(q)repo} HERDR_SOCKET_PATH=${(q)socket_path} timeout 5s herdr workspace list >/dev/null 2>&1"
local health_rc

if ssh -T -o ConnectTimeout=5 -o ConnectionAttempts=1 "$host" "$check_runner" >/dev/null 2>&1; then
  health_rc=0
else
  health_rc=$?
fi
if (( health_rc == 255 )); then
  echo "SSH transport to '$host' failed; not attempting rdev." >&2
  return 255
elif (( health_rc != 0 )); then
  echo "Remote Herdr session '$repo' is not running; preparing/registering it with rdev..." >&2
  rdev "$repo" || return $?
fi

local inner_cmd="export PATH=${(q)remote_path}; if [[ ! -S ${(q)socket_path} ]]; then echo Remote Herdr session ${(q)repo} is absent or stale. Run: rdev ${(q)repo} >&2; exit 1; fi; if [[ -d ${(q)repo_dir} ]]; then cd ${(q)repo_dir}; elif [[ -d ${(q)plain_repo_dir} ]]; then cd ${(q)plain_repo_dir}; else echo Remote repo not found: ${(q)repo_dir} or ${(q)plain_repo_dir} >&2; exit 1; fi; export HERDR_SOCKET_PATH=${(q)socket_path}; export RDEV_DOTFILES=${(q)dotfiles}; source ${(q)dotfiles}/zsh/functions/hwtcreate ${(q)requested}"
local encoded
encoded=$(printf '%s' "$inner_cmd" | base64 | tr -d '\n') || return
local runner="encoded=${(q)encoded}; cmd=\$(printf %s \"\$encoded\" | base64 -d); sudo -u ${(q)remote_user} HOME=${(q)remote_home} USER=${(q)remote_user} LOGNAME=${(q)remote_user} PATH=${(q)remote_path} ${(q)remote_home}/.nix-profile/bin/zsh -lc \"\$cmd\""

ssh -T "$host" "$runner"
