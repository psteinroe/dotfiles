# Git worktree helper - cleans integrated worktrees and confirmed stale local changes
git worktree list

if ! command -v gh >/dev/null 2>&1; then
  echo "\nGitHub CLI (gh) required for safe cleanup."
  return 1
fi

echo "\nChecking PR status..."
local repo_root=$(git rev-parse --show-toplevel 2>/dev/null)
local temp_file=$(mktemp)
local wt_file=$(mktemp)
local status_dir=$(mktemp -d)

local dotfiles="${RDEV_DOTFILES:-$HOME/Developer/dotfiles}"
source "$dotfiles/zsh/functions/_wt_tmux_helpers" 2>/dev/null || true
source "$dotfiles/zsh/functions/_herdr_worktree_helpers" 2>/dev/null || true
local session_repo_root=""
if (( $+functions[_wt_main_repo_root] )); then
  session_repo_root=$(_wt_main_repo_root)
fi
local herdr_repo_name=""
if (( $+functions[_h_repo_context] )); then
  _h_repo_context >/dev/null 2>&1 && herdr_repo_name="${H_REPO_NAME:-}"
fi

local default_branch=$(gh repo view --json defaultBranchRef -q '.defaultBranchRef.name' 2>/dev/null)
if [ -z "$default_branch" ]; then
  default_branch=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##')
fi
[ -n "$default_branch" ] || default_branch="main"

local protected_branches=("$default_branch" main master trunk)

is_protected_branch() {
  local branch="$1"
  local protected
  for protected in "${protected_branches[@]}"; do
    if [ "$branch" = "$protected" ]; then
      return 0
    fi
  done
  return 1
}

_wt_file_mtime() {
  local file_path="$1"
  local mtime
  mtime=$(stat -c %Y -- "$file_path" 2>/dev/null) || mtime=$(stat -f %m -- "$file_path" 2>/dev/null) || return 1
  print -r -- "$mtime"
}

_wt_latest_dirty_mtime() {
  local worktree_path="$1"
  local file mtime latest=0

  # A deleted file has no filesystem timestamp that tells us when deletion
  # happened. Treat such worktrees as unknown instead of guessing from Git or
  # directory metadata.
  if [[ -n "$(git -C "$worktree_path" diff --name-only --diff-filter=D -- 2>/dev/null)" ]] \
    || [[ -n "$(git -C "$worktree_path" diff --cached --name-only --diff-filter=D -- 2>/dev/null)" ]]; then
    return 2
  fi

  while IFS= read -r -d '' file; do
    [[ -e "$worktree_path/$file" ]] || continue
    mtime=$(_wt_file_mtime "$worktree_path/$file") || continue
    (( mtime > latest )) && latest=$mtime
  done < <(
    git -C "$worktree_path" diff --name-only -z --diff-filter=ACMRTUXB -- 2>/dev/null
    git -C "$worktree_path" diff --cached --name-only -z --diff-filter=ACMRTUXB -- 2>/dev/null
    git -C "$worktree_path" ls-files --others --exclude-standard -z 2>/dev/null
  )

  (( latest > 0 )) || return 1
  print -r -- "$latest"
}

_wt_has_active_agent() {
  local worktree_path="$1"
  local session_json workspace_id panes

  command -v herdr >/dev/null 2>&1 || return 1
  command -v jq >/dev/null 2>&1 || return 1

  if [[ -n "${HERDR_SOCKET_PATH:-}" ]] || [[ -n "${HERDR_SESSION:-}" ]]; then
    session_json=$(_h_session_json 2>/dev/null) || return 1
    workspace_id=$(jq -r --arg cwd "$worktree_path" \
      '.workspaces[]? | select((.identity_cwd // "") == $cwd) | .id' \
      "$session_json" 2>/dev/null | head -n 1)
    [[ -n "$workspace_id" ]] || return 1
    panes=$(herdr pane list --workspace "$workspace_id" 2>/dev/null) || return 1
  elif [[ -n "$herdr_repo_name" ]]; then
    session_json="${XDG_CONFIG_HOME:-$HOME/.config}/herdr/sessions/$herdr_repo_name/session.json"
    [[ -r "$session_json" ]] || return 1
    workspace_id=$(jq -r --arg cwd "$worktree_path" \
      '.workspaces[]? | select((.identity_cwd // "") == $cwd) | .id' \
      "$session_json" 2>/dev/null | head -n 1)
    [[ -n "$workspace_id" ]] || return 1
    panes=$(HERDR_SESSION="$herdr_repo_name" herdr pane list --workspace "$workspace_id" 2>/dev/null) || return 1
  else
    return 1
  fi

  print -r -- "$panes" | jq -e '
    .result.panes[]?
    | select(
        ((.agent // "") != "")
        and ((.agent_status // "unknown") as $status
          | $status != "idle" and $status != "done")
      )
  ' >/dev/null 2>&1
}

if git remote get-url origin >/dev/null 2>&1; then
  if ! git fetch --quiet origin "+refs/heads/${default_branch}:refs/remotes/origin/${default_branch}"; then
    echo "Could not refresh origin/$default_branch; cleanup classification aborted." >&2
    rm -f "$temp_file" "$wt_file"
    rm -rf "$status_dir"
    return 1
  fi
fi

local integration_ref="refs/remotes/origin/$default_branch"
if ! git show-ref --verify --quiet "$integration_ref"; then
  integration_ref="refs/heads/$default_branch"
fi
if ! git show-ref --verify --quiet "$integration_ref"; then
  echo "Could not resolve the default branch for integration checks: $default_branch" >&2
  rm -f "$temp_file" "$wt_file"
  rm -rf "$status_dir"
  return 1
fi

local stale_days="${WTCLEAN_STALE_DAYS:-7}"
[[ "$stale_days" == <-> ]] || stale_days=7
local stale_before=$(( $(date +%s) - stale_days * 24 * 60 * 60 ))

# Collect worktrees (avoid piped while-read subshell)
git worktree list --porcelain | grep '^worktree' | cut -d' ' -f2- > "$wt_file"

local worktrees=()
while read worktree_path; do
  if [ "$worktree_path" != "$repo_root" ] && [ "$worktree_path" != "$(dirname "$repo_root")/$(basename "$repo_root")" ]; then
    local branch=$(git -C "$worktree_path" branch --show-current 2>/dev/null)
    if [ -n "$branch" ]; then
      if is_protected_branch "$branch"; then
        echo "Protected: $branch"
        continue
      fi
      worktrees+=("$worktree_path:$branch")
    fi
  fi
done < "$wt_file"
rm -f "$wt_file"

# Check PR status in parallel (suppress job control noise)
setopt local_options no_monitor no_notify
local pids=()
local status_files=()
for entry in "${worktrees[@]}"; do
  local branch="${entry#*:}"
  local status_file="$status_dir/$(( ${#status_files[@]} + 1 ))"
  gh pr view "$branch" --json state -q '.state' > "$status_file" 2>/dev/null &
  pids+=($!)
  status_files+=("$status_file")
done
for pid in "${pids[@]}"; do wait "$pid" 2>/dev/null; done

local status_index=1
local has_stale_candidates=0
for entry in "${worktrees[@]}"; do
  local worktree_path="${entry%%:*}"
  local branch="${entry#*:}"
  local pr_state=$(<"${status_files[$status_index]}")
  local candidate_source=""
  status_index=$((status_index + 1))

  case "$pr_state" in
    "MERGED") candidate_source="merged PR" ;;
    # Removing a clean checkout does not delete its branch, so a closed PR can
    # be hibernated safely and recreated later through wtensure/hwtcreate.
    "CLOSED") candidate_source="closed PR" ;;
    "OPEN") echo "Active: $branch"; continue ;;
    "")
      if git -C "$worktree_path" merge-base --is-ancestor HEAD "$integration_ref" 2>/dev/null; then
        candidate_source="integrated into $default_branch"
      else
        echo "No PR, not integrated: $branch"
        continue
      fi
      ;;
    *) echo "Unknown PR state '$pr_state': $branch"; continue ;;
  esac

  local dirty_status=$(git -C "$worktree_path" status --porcelain=v1 2>/dev/null)
  if [[ -z "$dirty_status" ]]; then
    if _wt_has_active_agent "$worktree_path"; then
      echo "Integrated but active agent session (review): $branch"
      continue
    fi
    echo "Removable ($candidate_source): $branch"
    printf '%s\t%s\t%s\t%s\n' "$worktree_path" "$branch" safe "" >> "$temp_file"
    continue
  fi

  local latest_mtime
  latest_mtime=$(_wt_latest_dirty_mtime "$worktree_path")
  local mtime_status=$?
  if (( mtime_status != 0 )); then
    echo "Local changes with unknown age (review): $branch"
    continue
  fi

  local age_days=$(( ($(date +%s) - latest_mtime) / (24 * 60 * 60) ))
  if (( latest_mtime <= stale_before )); then
    echo "Stale local changes (${age_days}d, $candidate_source): $branch"
    printf '%s\t%s\t%s\t%s\n' "$worktree_path" "$branch" stale-dirty "$age_days" >> "$temp_file"
    has_stale_candidates=1
  else
    echo "Recent local changes (${age_days}d, review): $branch"
  fi
done
rm -rf "$status_dir"

if [ ! -s "$temp_file" ]; then
  echo "\nNo safely removable worktrees found."
  rm -f "$temp_file"
  return 0
fi

echo "\nRemovable worktrees:"
while IFS=$'\t' read -r worktree_path branch candidate_kind age_days; do
  if [[ "$candidate_kind" == stale-dirty ]]; then
    echo "  $branch [DESTRUCTIVE: stale local changes, ${age_days}d old]"
  else
    echo "  $branch [safe]"
  fi
done < "$temp_file"

if (( has_stale_candidates )); then
  echo -n "\nRemove these? WARNING: listed stale local changes will be permanently lost. (y/N): "
else
  echo -n "\nRemove these? (y/N): "
fi
read response
local cleanup_status=0
if [[ "$response" =~ ^[Yy]$ ]]; then
  # Remove worktrees in parallel, then clean up only the tmux/Herdr workspaces
  # whose Git removals succeeded. Guard protected branches again here so a
  # stale temp file can never remove main/default.
  local remove_pids=()
  local remove_paths=()
  local remove_branches=()
  while IFS=$'\t' read -r worktree_path branch candidate_kind age_days; do
    if is_protected_branch "$branch"; then
      echo "Skipping protected branch: $branch"
      continue
    fi
    echo "Removing $branch..."
    git worktree remove --force "$worktree_path" &
    remove_pids+=($!)
    remove_paths+=("$worktree_path")
    remove_branches+=("$branch")
  done < "$temp_file"

  local failed_removals=0
  local successful_indexes=()
  local i
  for (( i = 1; i <= ${#remove_pids[@]}; i++ )); do
    if wait "${remove_pids[$i]}"; then
      successful_indexes+=("$i")
    else
      echo "Failed to remove ${remove_branches[$i]} (${remove_paths[$i]})." >&2
      failed_removals=$((failed_removals + 1))
    fi
  done

  for i in "${successful_indexes[@]}"; do
    worktree_path="${remove_paths[$i]}"
    if (( $+functions[_wt_kill_tmux_for_worktree] )); then
      _wt_kill_tmux_for_worktree "$session_repo_root" "$worktree_path"
    fi
    if (( $+functions[_h_close_workspace_for_path] )); then
      _h_close_workspace_for_path "$worktree_path" "$herdr_repo_name" || true
    fi
  done

  git worktree prune
  if (( $+functions[_h_prune_missing_workspaces] )) && [[ -n "$herdr_repo_name" ]]; then
    HERDR_SESSION="$herdr_repo_name" _h_prune_missing_workspaces || true
  fi

  if (( failed_removals > 0 )); then
    echo "\nCleanup incomplete: $failed_removals worktree(s) could not be removed." >&2
    cleanup_status=1
  else
    echo "\nDone."
  fi
else
  echo "Cancelled."
fi

rm -f "$temp_file"
return "$cleanup_status"
