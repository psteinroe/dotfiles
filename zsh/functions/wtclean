# Git worktree helper - cleans integrated worktrees and confirmed stale local changes
git worktree list

if ! command -v gh >/dev/null 2>&1; then
  echo "\nGitHub CLI (gh) required for safe cleanup."
  return 1
fi

echo "\nChecking PR status..."
local repo_root temp_file wt_file status_dir
repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
temp_file=$(mktemp) || return 1
wt_file=$(mktemp) || { rm -f "$temp_file"; return 1; }
status_dir=$(mktemp -d) || { rm -f "$temp_file" "$wt_file"; return 1; }
local inspection_failures=0

local dotfiles="${RDEV_DOTFILES:-$HOME/Developer/dotfiles}"
source "$dotfiles/zsh/functions/_wt_tmux_helpers" 2>/dev/null || true
source "$dotfiles/zsh/functions/_herdr_worktree_helpers" 2>/dev/null || true
local session_repo_root=""
if (( $+functions[_wt_main_repo_root] )); then
  session_repo_root=$(_wt_main_repo_root)
fi
local herdr_repo_name=""
if (( $+functions[_h_repo_context] )); then
  _h_repo_context >/dev/null 2>&1 && herdr_repo_name="${H_REPO_NAME:-}"
fi

local default_branch=$(gh repo view --json defaultBranchRef -q '.defaultBranchRef.name' 2>/dev/null)
if [ -z "$default_branch" ]; then
  default_branch=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##')
fi
[ -n "$default_branch" ] || default_branch="main"

local protected_branches=("$default_branch" main master trunk)

is_protected_branch() {
  local branch="$1"
  local protected
  for protected in "${protected_branches[@]}"; do
    if [ "$branch" = "$protected" ]; then
      return 0
    fi
  done
  return 1
}

_wt_file_mtime() {
  local file_path="$1"
  local mtime
  mtime=$(stat -c %Y -- "$file_path" 2>/dev/null) || mtime=$(stat -f %m -- "$file_path" 2>/dev/null) || return 1
  print -r -- "$mtime"
}

_wt_latest_dirty_mtime() {
  local worktree_path="$1"
  local file mtime deleted changes latest=0

  # Any incomplete inspection makes age unknown. A deletion has no reliable
  # timestamp; dangling symlinks must be inspected themselves, not ignored.
  deleted=$(git -C "$worktree_path" diff --name-only --diff-filter=D -- 2>/dev/null) || return 2
  [[ -z "$deleted" ]] || return 2
  deleted=$(git -C "$worktree_path" diff --cached --name-only --diff-filter=D -- 2>/dev/null) || return 2
  [[ -z "$deleted" ]] || return 2
  changes=$(mktemp) || return 2
  if ! git -C "$worktree_path" diff --name-only -z --diff-filter=ACMRTUXB -- > "$changes" 2>/dev/null \
    || ! git -C "$worktree_path" diff --cached --name-only -z --diff-filter=ACMRTUXB -- >> "$changes" 2>/dev/null \
    || ! git -C "$worktree_path" ls-files --others --exclude-standard -z >> "$changes" 2>/dev/null; then
    rm -f "$changes"
    return 2
  fi
  while IFS= read -r -d '' file; do
    if [[ ! -e "$worktree_path/$file" && ! -L "$worktree_path/$file" ]]; then
      rm -f "$changes"; return 2
    fi
    mtime=$(_wt_file_mtime "$worktree_path/$file") || { rm -f "$changes"; return 2; }
    (( mtime > latest )) && latest=$mtime
  done < "$changes"
  rm -f "$changes"
  (( latest > 0 )) || return 1
  print -r -- "$latest"
}

_wt_has_active_agent() {
  local worktree_path="$1"
  # 0 = live agent, 1 = verified absent, 2 = inspection unknown.
  local session_json workspace_ids workspace_id panes scope jq_status
  local session_files=() session_scopes=()
  command -v herdr >/dev/null 2>&1 || return 2
  command -v jq >/dev/null 2>&1 || return 2

  if [[ -n "${HERDR_SOCKET_PATH:-}" || -n "${HERDR_SESSION:-}" ]]; then
    session_json=$(_h_session_json 2>/dev/null) || return 2
    [[ -r "$session_json" ]] || return 2
    session_files+=("$session_json"); session_scopes+=(inherited)
  else
    # Inspect the same named + default sessions that workspace cleanup uses.
    if [[ -n "$herdr_repo_name" ]]; then
      session_json="${XDG_CONFIG_HOME:-$HOME/.config}/herdr/sessions/$herdr_repo_name/session.json"
      if [[ -e "$session_json" ]]; then
        [[ -r "$session_json" ]] || return 2
        session_files+=("$session_json"); session_scopes+=("$herdr_repo_name")
      fi
    fi
    session_json="${XDG_CONFIG_HOME:-$HOME/.config}/herdr/session.json"
    if [[ -e "$session_json" ]]; then
      [[ -r "$session_json" ]] || return 2
      session_files+=("$session_json"); session_scopes+=(default)
    fi
  fi
  local index
  for (( index=1; index<=${#session_files[@]}; index++ )); do
    session_json="${session_files[$index]}"; scope="${session_scopes[$index]}"
    jq -e 'type == "object" and (.workspaces | type == "array")' "$session_json" >/dev/null 2>&1 || return 2
    workspace_ids=$(jq -r --arg cwd "$worktree_path" \
      '.workspaces[]? | select((.identity_cwd // "") == $cwd) | .id' "$session_json" 2>/dev/null) || return 2
    for workspace_id in "${(@f)workspace_ids}"; do
      [[ -n "$workspace_id" ]] || continue
      if [[ "$scope" == inherited ]]; then
        panes=$(herdr pane list --workspace "$workspace_id" 2>/dev/null) || return 2
      else
        panes=$(herdr --session "$scope" pane list --workspace "$workspace_id" 2>/dev/null) || return 2
      fi
      print -r -- "$panes" | jq -e '.result.panes | type == "array"' >/dev/null 2>&1 || return 2
      if print -r -- "$panes" | jq -e 'any(.result.panes[]?; (.agent // "") != "")' >/dev/null 2>&1; then
        return 0
      else
        jq_status=$?
        (( jq_status == 1 )) || return 2
      fi
    done
  done
  return 1
}

_wt_removal_preflight() {
  python3 "$dotfiles/zsh/lib/wtclean_safety.py" "$1"
}

if git remote get-url origin >/dev/null 2>&1; then
  if ! git fetch --quiet origin "+refs/heads/${default_branch}:refs/remotes/origin/${default_branch}"; then
    echo "Could not refresh origin/$default_branch; cleanup classification aborted." >&2
    rm -f "$temp_file" "$wt_file"
    rm -rf "$status_dir"
    return 1
  fi
fi

local integration_ref="refs/remotes/origin/$default_branch"
if ! git show-ref --verify --quiet "$integration_ref"; then
  integration_ref="refs/heads/$default_branch"
fi
if ! git show-ref --verify --quiet "$integration_ref"; then
  echo "Could not resolve the default branch for integration checks: $default_branch" >&2
  rm -f "$temp_file" "$wt_file"
  rm -rf "$status_dir"
  return 1
fi

local stale_days="${WTCLEAN_STALE_DAYS:-7}"
[[ "$stale_days" == <-> ]] || stale_days=7
local stale_before=$(( $(date +%s) - stale_days * 24 * 60 * 60 ))

# Collect worktrees (avoid piped while-read subshell)
git worktree list --porcelain | grep '^worktree' | cut -d' ' -f2- > "$wt_file"

local worktrees=()
while read worktree_path; do
  if [ "$worktree_path" != "$repo_root" ] && [ "$worktree_path" != "$(dirname "$repo_root")/$(basename "$repo_root")" ]; then
    local branch=$(git -C "$worktree_path" branch --show-current 2>/dev/null)
    if [ -n "$branch" ]; then
      if is_protected_branch "$branch"; then
        echo "Protected: $branch"
        continue
      fi
      worktrees+=("$worktree_path:$branch")
    fi
  fi
done < "$wt_file"
rm -f "$wt_file"

# Check PR status in parallel (suppress job control noise)
setopt local_options no_monitor no_notify
local pids=()
local status_files=()
for entry in "${worktrees[@]}"; do
  local branch="${entry#*:}"
  local status_file="$status_dir/$(( ${#status_files[@]} + 1 ))"
  gh pr view "$branch" --json state -q '.state' > "$status_file" 2>/dev/null &
  pids+=($!)
  status_files+=("$status_file")
done
for pid in "${pids[@]}"; do wait "$pid" 2>/dev/null; done

local status_index=1
local has_stale_candidates=0
for entry in "${worktrees[@]}"; do
  local worktree_path="${entry%%:*}"
  local branch="${entry#*:}"
  local pr_state=$(<"${status_files[$status_index]}")
  local candidate_source=""
  status_index=$((status_index + 1))

  case "$pr_state" in
    "MERGED")
      # A historical merged PR does not prove that newer local commits landed.
      if ! git -C "$worktree_path" merge-base --is-ancestor HEAD "$integration_ref" 2>/dev/null; then
        local pr_head current_head
        pr_head=$(gh pr view "$branch" --json headRefOid -q '.headRefOid' 2>/dev/null)
        current_head=$(git -C "$worktree_path" rev-parse HEAD 2>/dev/null) || continue
        if [[ "$pr_head" != "$current_head" ]]; then
          echo "Merged PR but current tip is unverified (review): $branch"
          continue
        fi
      fi
      candidate_source="merged PR"
      ;;
    # Removing a clean checkout does not delete its branch, so a closed PR can
    # be hibernated safely and recreated later through wtensure/hwtcreate.
    "CLOSED") candidate_source="closed PR" ;;
    "OPEN") echo "Active: $branch"; continue ;;
    "")
      if git -C "$worktree_path" merge-base --is-ancestor HEAD "$integration_ref" 2>/dev/null; then
        candidate_source="integrated into $default_branch"
      else
        echo "No PR, not integrated: $branch"
        continue
      fi
      ;;
    *) echo "Unknown PR state '$pr_state': $branch"; continue ;;
  esac

  local dirty_status candidate_head agent_status
  if ! dirty_status=$(git -C "$worktree_path" status --porcelain=v1 2>/dev/null); then
    echo "Git status unavailable (review): $branch"
    inspection_failures=$((inspection_failures + 1))
    continue
  fi
  candidate_head=$(git -C "$worktree_path" rev-parse HEAD 2>/dev/null) || { inspection_failures=$((inspection_failures + 1)); continue; }
  if _wt_has_active_agent "$worktree_path"; then
    echo "Integrated but live agent session (review): $branch"
    continue
  else
    agent_status=$?
    if (( agent_status != 1 )); then
      echo "Agent state unknown (review): $branch"
      inspection_failures=$((inspection_failures + 1))
      continue
    fi
  fi
  if ! _wt_removal_preflight "$worktree_path"; then
    echo "Not safely removable; filesystem review required: $branch"
    inspection_failures=$((inspection_failures + 1))
    continue
  fi
  if [[ -z "$dirty_status" ]]; then
    echo "Removable ($candidate_source; Git-clean, including ignored files): $branch"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$worktree_path" "$branch" safe 0 "$candidate_head" 0 none >> "$temp_file"
    continue
  fi

  local latest_mtime
  latest_mtime=$(_wt_latest_dirty_mtime "$worktree_path")
  local mtime_status=$?
  if (( mtime_status != 0 )); then
    echo "Local changes with unknown age (review): $branch"
    continue
  fi

  local age_days=$(( ($(date +%s) - latest_mtime) / (24 * 60 * 60) ))
  if (( latest_mtime <= stale_before )); then
    local dirty_fingerprint
    if ! dirty_fingerprint=$(python3 "$dotfiles/zsh/lib/wtclean_safety.py" --fingerprint "$worktree_path"); then
      echo "Dirty contents unavailable (review): $branch"
      inspection_failures=$((inspection_failures + 1))
      continue
    fi
    echo "Stale local changes (${age_days}d, $candidate_source): $branch"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$worktree_path" "$branch" stale-dirty "$age_days" "$candidate_head" "$latest_mtime" "$dirty_fingerprint" >> "$temp_file"
    has_stale_candidates=1
  else
    echo "Recent local changes (${age_days}d, review): $branch"
  fi
done
rm -rf "$status_dir"

if [ ! -s "$temp_file" ]; then
  echo "\nNo safely removable worktrees found."
  rm -f "$temp_file"
  (( inspection_failures == 0 ))
  return $?
fi

echo "\nRemovable worktrees (ignored files are also removed):"
local candidate_head saved_mtime saved_fingerprint
while IFS=$'\t' read -r worktree_path branch candidate_kind age_days candidate_head saved_mtime saved_fingerprint; do
  if [[ "$candidate_kind" == stale-dirty ]]; then
    echo "  $branch [DESTRUCTIVE: stale local changes, ${age_days}d old]"
  else
    echo "  $branch [Git-clean; ignored files included]"
  fi
done < "$temp_file"

if (( has_stale_candidates )); then
  echo -n "\nRemove these? WARNING: listed stale local changes will be permanently lost. (y/N): "
else
  echo -n "\nRemove these? (y/N): "
fi
read response
local cleanup_status=0
(( inspection_failures > 0 )) && cleanup_status=1
if [[ "$response" =~ ^[Yy]$ ]]; then
  # Remove worktrees in parallel, then close only their matching Herdr
  # workspaces after successful removal. Revalidate every candidate first.
  local remove_pids=()
  local remove_paths=()
  local remove_branches=()
  while IFS=$'\t' read -r worktree_path branch candidate_kind age_days candidate_head saved_mtime saved_fingerprint; do
    # Revalidate after the user prompt. Clean removals must not use --force.
    local current_branch current_head current_dirty current_mtime current_fingerprint
    if ! current_branch=$(git -C "$worktree_path" branch --show-current 2>/dev/null) \
      || ! current_head=$(git -C "$worktree_path" rev-parse HEAD 2>/dev/null) \
      || ! current_dirty=$(git -C "$worktree_path" status --porcelain=v1 2>/dev/null) \
      || [[ "$current_branch" != "$branch" || "$current_head" != "$candidate_head" ]] \
      || is_protected_branch "$current_branch"; then
      echo "Skipping changed/unreadable checkout (review): $branch"
      cleanup_status=1
      continue
    fi
    if _wt_has_active_agent "$worktree_path"; then
      echo "Skipping live agent session: $branch"
      cleanup_status=1
      continue
    else
      agent_status=$?
      if (( agent_status != 1 )); then
        echo "Skipping unknown agent state: $branch"; cleanup_status=1; continue
      fi
    fi
    if ! _wt_removal_preflight "$worktree_path"; then
      cleanup_status=1
      continue
    fi
    if [[ "$candidate_kind" == stale-dirty ]]; then
      current_mtime=$(_wt_latest_dirty_mtime "$worktree_path") || { cleanup_status=1; continue; }
      if [[ "$current_mtime" != "$saved_mtime" ]] || (( current_mtime > stale_before )); then
        echo "Skipping changed local work: $branch"; cleanup_status=1; continue
      fi
      current_fingerprint=$(python3 "$dotfiles/zsh/lib/wtclean_safety.py" --fingerprint "$worktree_path") || { cleanup_status=1; continue; }
      if [[ "$current_fingerprint" != "$saved_fingerprint" ]]; then
        echo "Skipping changed dirty contents: $branch"; cleanup_status=1; continue
      fi
      echo "Removing $branch (confirmed stale local changes)..."
      git worktree remove --force "$worktree_path" &
    else
      if [[ -n "$current_dirty" ]]; then
        echo "Skipping newly dirty checkout: $branch"; cleanup_status=1; continue
      fi
      echo "Removing $branch..."
      git worktree remove "$worktree_path" &
    fi
    remove_pids+=($!)
    remove_paths+=("$worktree_path")
    remove_branches+=("$branch")
  done < "$temp_file"

  local failed_removals=0
  local successful_indexes=()
  local i
  for (( i = 1; i <= ${#remove_pids[@]}; i++ )); do
    if wait "${remove_pids[$i]}"; then
      successful_indexes+=("$i")
    else
      echo "Failed to remove ${remove_branches[$i]} (${remove_paths[$i]})." >&2
      failed_removals=$((failed_removals + 1))
    fi
  done

  for i in "${successful_indexes[@]}"; do
    worktree_path="${remove_paths[$i]}"
    # Do not kill tmux sessions whose foreground/background activity was not
    # positively checked. Herdr cleanup is limited to verified-inactive paths.
    if (( $+functions[_h_close_workspace_for_path] )); then
      _h_close_workspace_for_path "$worktree_path" "$herdr_repo_name" || true
    fi
  done

  git worktree prune
  # No global workspace prune here: failed Git removals can leave an
  # unregistered directory, and unrelated orphaned sessions must be preserved.
  if (( failed_removals > 0 )); then
    echo "\nCleanup incomplete: $failed_removals worktree(s) could not be removed." >&2
    cleanup_status=1
  elif (( cleanup_status != 0 )); then
    echo "\nCleanup incomplete: some candidates require review." >&2
  else
    echo "\nDone."
  fi
else
  echo "Cancelled."
fi

rm -f "$temp_file"
return "$cleanup_status"
