# Rebuild a Raspberry Pi from this machine: evaluate here, build or substitute on the Pi, activate there.
# Usage: pi-rebuild hub|office-connector [switch|boot|test|dry-activate|...] [nixos-rebuild args...]
# Targets: hub via HUB_SSH (see _hub); office-connector via OFFICE_CONNECTOR_SSH,
# default psteinroe@office-connector (MagicDNS short name in the work tailnet).
local usage="Usage: pi-rebuild hub|office-connector [action] [nixos-rebuild args...]"
local dotfiles="${DOTFILES_DIR:-$HOME/Developer/dotfiles}"
local host="$1" target
case "$host" in
  hub)
    local hub_url hub_ssh
    source "$dotfiles/zsh/functions/_hub" || return
    target="$hub_ssh"
    ;;
  office-connector) target="${OFFICE_CONNECTOR_SSH:-psteinroe@office-connector}" ;;
  -h|--help) echo "$usage"; return 0 ;;
  *) echo "$usage" >&2; return 1 ;;
esac
shift
local action="${1:-switch}"
(( $# )) && shift

# --no-reexec: re-exec would build the Pi's aarch64-linux nixos-rebuild here
nix run --inputs-from "$dotfiles" nixpkgs#nixos-rebuild-ng -- "$action" \
  --flake "$dotfiles#$host" --target-host "$target" --build-host "$target" \
  --elevate sudo --no-reexec "$@"
