# Cloud/API-key transfer only. OAuth for MCP and GitHub is per remote.
# Normally called through: remote auth HOST <kind>
_rauth_usage() {
  print -u2 'Usage: rauth --host HOST [--user USER --home PATH] exa|aws|gcloud|azure|infisical|all ...'
  print -u2 'Copies cloud credentials/API keys over SSH. Never copies provider, MCP, or GitHub OAuth.'
  print -u2 'Use remote auth HOST gh or remote auth HOST mcp SERVER for independent browser login.'
}
if [[ ${1:-} == --help || ${1:-} == '-?' ]]; then
  _rauth_usage
  return 0
fi
local host="" remote_user="" remote_home=""
local -a specs
while (( $# )); do
  case "$1" in
    --host|--user|--home)
      (( $# >= 2 )) || { _rauth_usage; return 1; }
      case "$1" in
        --host) host=$2 ;;
        --user) remote_user=$2 ;;
        --home) remote_home=$2 ;;
      esac
      shift 2 ;;
    -*) _rauth_usage; return 1 ;;
    *) specs+=("$1"); shift ;;
  esac
done
[[ -n "$host" && "$host" != -* && "$host" != *[[:space:]]* && ${#specs} -gt 0 ]] || { _rauth_usage; return 1; }
local spec
for spec in "${specs[@]}"; do
  case "$spec" in
    all|exa|aws|gcloud|azure|az|infisical) ;;
    *) _rauth_usage; return 1 ;;
  esac
done
if [[ -z "$remote_user" || -z "$remote_home" ]]; then
  local identity
  identity=$(ssh "$host" 'printf "%s\\n%s\\n" "$(id -un)" "$HOME"') || return
  local -a fields
  fields=("${(@f)identity}")
  (( ${#fields} == 2 )) || { print -u2 'Cannot determine the remote user/home'; return 1; }
  remote_user=${remote_user:-$fields[1]}
  remote_home=${remote_home:-$fields[2]}
fi
local remote_path="${remote_home}/.local/bin:${remote_home}/.nix-profile/bin:/etc/profiles/per-user/${remote_user}/bin:/run/current-system/sw/bin:/nix/var/nix/profiles/default/bin:/usr/local/bin:/usr/bin:/bin"
_rauth_runner() {
  local remote_cmd="$1"
  local env_extra="${2:-}"
  local encoded env_assignments
  encoded=$(printf '%s' "$remote_cmd" | base64 | tr -d '\n') || return
  env_assignments="HOME=${(q)remote_home} USER=${(q)remote_user} LOGNAME=${(q)remote_user} PATH=${(q)remote_path} ${env_extra}"
  print -r -- "encoded=${(q)encoded}; cmd=\$(printf %s \"\$encoded\" | base64 -d); if [ \"\$(id -un)\" = ${(q)remote_user} ]; then ${env_assignments} bash -lc \"\$cmd\"; else sudo -u ${(q)remote_user} ${env_assignments} bash -lc \"\$cmd\"; fi"
}

_rauth_check_jq() {
  command -v jq >/dev/null 2>&1 || { echo "rauth requires jq locally" >&2; return 1; }
  ssh "$host" 'command -v jq >/dev/null 2>&1' >/dev/null 2>&1 || {
    echo "rauth requires jq on $host; run remote setup HOST first" >&2
    return 1
  }
}

_rauth_read_secret_file() {
  local file="$1"
  [[ -n "$file" && -f "$file" ]] || return 1
  local value
  value=$(<"$file") || return 1
  value="${value//$'\n'/}"
  value="${value//$'\r'/}"
  [[ -n "$value" ]] || return 1
  print -r -- "$value"
}

_rauth_read_keychain_env() {
  local name="$1"
  [[ "$(uname -s)" == Darwin ]] || return 1
  security find-generic-password -w -a "${USER}" -D "environment variable" -s "$name" 2>/dev/null
}

_rauth_read_exa_key() {
  if [[ -n "${EXA_API_KEY:-}" ]]; then print -r -- "$EXA_API_KEY"; return 0; fi
  if [[ -n "${EXA_API_TOKEN:-}" ]]; then print -r -- "$EXA_API_TOKEN"; return 0; fi
  if [[ -n "${EXA_API_KEY_FILE:-}" ]] && _rauth_read_secret_file "$EXA_API_KEY_FILE"; then return 0; fi
  if _rauth_read_keychain_env EXA_API_KEY; then return 0; fi
  if _rauth_read_keychain_env EXA_API_TOKEN; then return 0; fi
  _rauth_read_secret_file "${XDG_CONFIG_HOME:-$HOME/.config}/exa/api_key"
}

_rauth_copy_exa() {
  local exa_key
  exa_key=$(_rauth_read_exa_key) || {
    echo "No Exa API key found. Set EXA_API_KEY, EXA_API_TOKEN, EXA_API_KEY_FILE, keychain EXA_API_KEY, or ~/.config/exa/api_key." >&2
    return 1
  }

  local remote_cmd='set -euo pipefail
umask 077
mkdir -p "$HOME/.config/exa"
tmp=$(mktemp "$HOME/.config/exa/api_key.XXXXXX")
trap '\''rm -f "$tmp"'\'' EXIT
cat > "$tmp"
if [ ! -s "$tmp" ]; then
  echo "No Exa API key received on stdin" >&2
  exit 1
fi
mv "$tmp" "$HOME/.config/exa/api_key"
chmod 600 "$HOME/.config/exa/api_key"
'
  local runner
  runner=$(_rauth_runner "$remote_cmd") || return
  printf '%s\n' "$exa_key" | ssh "$host" "$runner" || return
  print -r -- "Copied Exa API key to $host:$remote_user:$remote_home/.config/exa/api_key"
}

_rauth_copy_aws() {
  local local_aws_dir="$HOME/.aws"
  [[ -d "$local_aws_dir" ]] || { echo "AWS auth directory not found: $local_aws_dir" >&2; return 1; }

  local remote_cmd='set -euo pipefail
umask 077
tmp=$(mktemp -d)
trap '\''rm -rf "$tmp"'\'' EXIT
tar -xzf - -C "$tmp"
if [ ! -d "$tmp/.aws" ]; then
  echo "Archive did not contain .aws directory" >&2
  exit 1
fi
rm -rf "$HOME/.aws"
mkdir -p "$HOME/.aws"
cp -R "$tmp/.aws/." "$HOME/.aws/"
chmod -R go-rwx "$HOME/.aws"
find "$HOME/.aws" -type d -exec chmod 700 {} +
find "$HOME/.aws" -type f -exec chmod 600 {} +
'
  local runner
  runner=$(_rauth_runner "$remote_cmd") || return
  COPYFILE_DISABLE=1 tar --no-xattrs -czf - -C "$HOME" .aws | ssh "$host" "$runner" || return
  print -r -- "Copied AWS auth to $host:$remote_user:$remote_home/.aws"
}

# Machine-specific state stays behind: the remote keeps its own logs, and gce caches whether
# the machine itself runs on Google Compute Engine.
_rauth_copy_gcloud() {
  local local_gcloud_dir="${CLOUDSDK_CONFIG:-$HOME/.config/gcloud}"
  [[ -d "$local_gcloud_dir" ]] || { echo "gcloud config directory not found: $local_gcloud_dir. Run: gcloud auth login" >&2; return 1; }

  local remote_cmd='set -euo pipefail
umask 077
tmp=$(mktemp -d)
trap '\''rm -rf "$tmp"'\'' EXIT
tar -xzf - -C "$tmp"
if [ ! -f "$tmp/credentials.db" ] && [ ! -d "$tmp/configurations" ]; then
  echo "Archive did not contain gcloud credentials or configurations" >&2
  exit 1
fi
gcloud_dir="$HOME/.config/gcloud"
mkdir -p "$gcloud_dir"
find "$gcloud_dir" -mindepth 1 -maxdepth 1 ! -name logs -exec rm -rf {} +
cp -R "$tmp/." "$gcloud_dir/"
chmod -R go-rwx "$gcloud_dir"
'
  local runner
  runner=$(_rauth_runner "$remote_cmd") || return
  COPYFILE_DISABLE=1 tar --no-xattrs -czf - -C "$local_gcloud_dir" \
    --exclude ./logs --exclude ./gce --exclude ./virtenv --exclude ./.last_survey_prompt.yaml . \
    | ssh "$host" "$runner" || return
  print -r -- "Copied gcloud auth to $host:$remote_user:$remote_home/.config/gcloud"
}

# Only the login state: az's caches, indexes, logs and installed extensions stay per machine.
_rauth_azure_dir() {
  print -r -- "${AZURE_CONFIG_DIR:-$HOME/.azure}"
}

_rauth_has_azure_login() {
  local dir
  dir=$(_rauth_azure_dir)
  [[ -s "$dir/azureProfile.json" && -s "$dir/msal_token_cache.json" ]]
}

_rauth_copy_azure() {
  local local_azure_dir
  local_azure_dir=$(_rauth_azure_dir)
  _rauth_has_azure_login || { echo "No Azure CLI login found in $local_azure_dir. Run: az login" >&2; return 1; }

  local -a files
  local file
  files=()
  for file in azureProfile.json msal_token_cache.json service_principal_entries.json clouds.config config; do
    [[ -f "$local_azure_dir/$file" ]] && files+=("$file")
  done

  # Login files the local machine lacks are removed too, so no stale remote login survives.
  local remote_cmd='set -euo pipefail
umask 077
tmp=$(mktemp -d)
trap '\''rm -rf "$tmp"'\'' EXIT
tar -xzf - -C "$tmp"
if [ ! -s "$tmp/azureProfile.json" ] || [ ! -s "$tmp/msal_token_cache.json" ]; then
  echo "Archive did not contain an Azure CLI login" >&2
  exit 1
fi
azure_dir="$HOME/.azure"
mkdir -p "$azure_dir"
chmod 700 "$azure_dir"
for file in azureProfile.json msal_token_cache.json service_principal_entries.json clouds.config config; do
  rm -f "$azure_dir/$file"
  if [ -f "$tmp/$file" ]; then
    cp "$tmp/$file" "$azure_dir/$file"
    chmod 600 "$azure_dir/$file"
  fi
done
'
  local runner
  runner=$(_rauth_runner "$remote_cmd") || return
  COPYFILE_DISABLE=1 tar --no-xattrs -czf - -C "$local_azure_dir" "${files[@]}" | ssh "$host" "$runner" || return
  print -r -- "Copied Azure CLI auth to $host:$remote_user:$remote_home/.azure"
}

# Infisical on macOS keeps its login in the Keychain via go-keyring; the
# headless remote uses the CLI's encrypted file vault (~/infisical-keyring).
_rauth_read_infisical_payload() {
  local config="${INFISICAL_CONFIG_FILE:-$HOME/.infisical/infisical-config.json}"
  [[ -f "$config" ]] || return 1
  [[ "$(uname -s)" == Darwin ]] && command -v security >/dev/null 2>&1 || return 1
  local email domain stored credentials
  email=$(jq -r '.loggedInUserEmail // empty' "$config") || return 1
  domain=$(jq -r '.LoggedInUserDomain // empty' "$config") || return 1
  [[ -n "$email" && -n "$domain" ]] || return 1
  stored=$(security find-generic-password -s infisical-cli -a "$email" -w 2>/dev/null) || return 1
  if [[ "$stored" == go-keyring-base64:* ]]; then
    credentials=$(print -rn -- "${stored#go-keyring-base64:}" | base64 -d 2>/dev/null) || return 1
  else
    credentials="$stored"
  fi
  jq -ce --arg email "$email" --arg domain "$domain" '
    select(.JTWToken | type == "string" and length > 0)
    | {email: $email, domain: $domain, credentials: .}
  ' <<<"$credentials"
}

_rauth_infisical_expires_at() {
  jq -r '
    (.credentials.JTWToken | split(".")[1] | gsub("-"; "+") | gsub("_"; "/")) as $p
    | ($p + ("==" | .[0:((4 - ($p | length) % 4) % 4)])) | @base64d | fromjson | .exp // 0
  ' 2>/dev/null
}

_rauth_copy_infisical() {
  _rauth_check_jq || return
  local payload
  payload=$(_rauth_read_infisical_payload) || {
    echo "No local Infisical login found in the macOS Keychain. Run: infisical login" >&2
    return 1
  }
  local expires_at
  expires_at=$(_rauth_infisical_expires_at <<<"$payload")
  if [[ "$expires_at" != <-> ]] || (( expires_at <= $(date +%s) )); then
    echo "Local Infisical login has expired. Run: infisical login" >&2
    return 1
  fi

  local remote_cmd='set -euo pipefail
if ! command -v node >/dev/null 2>&1; then
  echo "rauth infisical requires node on the remote; run remote setup HOST first" >&2
  exit 1
fi
umask 077
payload=$(mktemp)
trap '\''rm -f "$payload"'\'' EXIT
cat > "$payload"
RAUTH_PAYLOAD="$payload" node - <<"JS"
const fs = require("fs"), path = require("path"), crypto = require("crypto");
const home = process.env.HOME;
const { email, domain, credentials } = JSON.parse(fs.readFileSync(process.env.RAUTH_PAYLOAD, "utf8"));
if (!/^[^/\0]+@[^/\0]+$/.test(email)) throw new Error("Invalid Infisical email");

function writeAtomic(file, data) {
  const tmp = `${file}.rauth-${process.pid}`;
  fs.writeFileSync(tmp, data, { mode: 0o600 });
  fs.renameSync(tmp, file);
}

const configDir = path.join(home, ".infisical");
const configPath = path.join(configDir, "infisical-config.json");
fs.mkdirSync(configDir, { recursive: true, mode: 0o700 });
let config = {};
try { config = JSON.parse(fs.readFileSync(configPath, "utf8")); }
catch (error) { if (error.code !== "ENOENT") throw error; }
// Reuse an existing file-vault passphrase: other vault entries depend on it.
if (config.vaultBackendType !== "file" || !config.vaultBackendPassphrase) {
  config.vaultBackendType = "file";
  config.vaultBackendPassphrase = crypto.randomBytes(12).toString("base64");
}

// Same JWE (PBES2-HS256+A128KW / A256GCM) the CLI file vault writes; the
// payload is the credential JSON encoded once more as a JSON string.
const header = { alg: "PBES2-HS256+A128KW", created: new Date().toISOString(), enc: "A256GCM",
  p2c: 8192, p2s: crypto.randomBytes(12).toString("base64url") };
const protectedHeader = Buffer.from(JSON.stringify(header)).toString("base64url");
const salt = Buffer.concat([Buffer.from(header.alg), Buffer.from([0]), Buffer.from(header.p2s, "base64url")]);
const kek = crypto.pbkdf2Sync(Buffer.from(config.vaultBackendPassphrase, "base64"), salt, header.p2c, 16, "sha256");
const cek = crypto.randomBytes(32);
const wrap = crypto.createCipheriv("id-aes128-wrap", kek, Buffer.from("A6A6A6A6A6A6A6A6", "hex"));
const encryptedKey = Buffer.concat([wrap.update(cek), wrap.final()]);
const iv = crypto.randomBytes(12);
const gcm = crypto.createCipheriv("aes-256-gcm", cek, iv);
gcm.setAAD(Buffer.from(protectedHeader));
const ciphertext = Buffer.concat([gcm.update(JSON.stringify(JSON.stringify(credentials))), gcm.final()]);
const jwe = [protectedHeader, ...[encryptedKey, iv, ciphertext, gcm.getAuthTag()].map((part) => part.toString("base64url"))].join(".");

const vaultDir = path.join(home, "infisical-keyring");
fs.mkdirSync(vaultDir, { recursive: true, mode: 0o700 });
writeAtomic(path.join(vaultDir, email), jwe);

config.loggedInUserEmail = email;
config.LoggedInUserDomain = domain;
const users = Array.isArray(config.loggedInUsers) ? config.loggedInUsers : [];
config.loggedInUsers = [...users.filter((user) => !(user.email === email && user.domain === domain)), { email, domain }];
writeAtomic(configPath, JSON.stringify(config, null, 2));
JS
'
  local runner
  runner=$(_rauth_runner "$remote_cmd") || return
  printf '%s' "$payload" | ssh "$host" "$runner" || return
  print -r -- "Copied Infisical login for $(jq -r .email <<<"$payload") to $host:$remote_user:$remote_home/infisical-keyring"
}


for spec in "${specs[@]}"; do
  case "$spec" in
    all)
      _rauth_copy_exa || return
      _rauth_copy_aws || return
      _rauth_copy_gcloud || return
      if _rauth_has_azure_login; then _rauth_copy_azure || return; fi
      _rauth_copy_infisical || return ;;
    exa) _rauth_copy_exa || return ;;
    aws) _rauth_copy_aws || return ;;
    gcloud) _rauth_copy_gcloud || return ;;
    azure|az) _rauth_copy_azure || return ;;
    infisical) _rauth_copy_infisical || return ;;
  esac
done
