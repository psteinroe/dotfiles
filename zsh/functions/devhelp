# List dotfiles helper commands and what they do.
# Usage: devhelp [remote|git|auth|all]
local topic="${1:-all}"

if [[ $# -gt 1 ]]; then
  echo "Usage: devhelp [remote|git|auth|all]" >&2
  return 1
fi

_case_header() {
  print -P "%F{cyan}$1%f"
}

_case_row() {
  printf '  %-32s %s\n' "$1" "$2"
}

case "$topic" in
  all|remote|git|auth) ;;
  *)
    echo "Unknown devhelp topic: $topic" >&2
    echo "Usage: devhelp [remote|git|auth|all]" >&2
    return 1
    ;;
esac

if [[ "$topic" == all || "$topic" == remote ]]; then
  _case_header "Machines"
  _case_row "rebuild [-u]" "rebuild this machine (-u updates flake inputs first)"
  _case_row "rrebuild [host]" "force-sync dotfiles on the remote and rebuild it"
  _case_row "rssh [dir]" "open a plain remote psteinroe shell"
  _case_row "ssh rdev-exe" "recovery path via exe.dev gateway"
  _case_row "pi-rebuild <host> [action]" "deploy a Raspberry Pi: hub or office-connector (builds on the Pi)"
  _case_row "hub-rebuild [action]" "shorthand for pi-rebuild hub"
  [[ "$topic" == all ]] && print
fi

if [[ "$topic" == all || "$topic" == git ]]; then
  _case_header "Git"
  _case_row "gpr [-a] [-n] [-e] [-d]" "commit, push and open a PR with a generated title/body"
  _case_row "gclean" "delete local branches merged into the default branch"
  _case_row "greset" "check out the default branch, pull, and gclean"
  [[ "$topic" == all ]] && print
fi

if [[ "$topic" == all || "$topic" == auth ]]; then
  _case_header "Auth"
  _case_row "rauth [spec...]" "copy local auth (gh, Pi, Claude, MCP, Exa, AWS, gcloud, Azure, Infisical) to the remote"
  _case_row "claude-login [--host h] [acct...]" "log in to the Claude accounts here or on a remote (skips logged-in ones)"
  _case_row "claude-accounts [--host h]" "show which Claude accounts are logged in"
  _case_row "claude-<account>" "run Claude Code as that account, e.g. claude-personal"
  _case_row "executor-login [--host h] [acct|codex...]" "register executor and log in to it, per account and Codex"
  _case_row "hub-login claude|codex" "add a Claude or Codex account to the hub's CLIProxyAPI"
  _case_row "hub-client [--host h]" "point ~/.claude-hub and ~/.codex-hub at the hub"
  _case_row "claude-hub / codex-hub" "run Claude Code / Codex through the hub"
  _case_row "gh" "wrap gh to auto-use exe.dev integration hosts from origin"
  _case_row "devhelp [topic]" "show this command reference"
fi
