# Usage: devhelp
printf '%s\n' \
  'rebuild [-u]                       Rebuild this machine (-u updates inputs)' \
  'remote setup HOST                 Add an existing NixOS dev machine' \
  'remote setup HOST --home-manager  Add an existing non-NixOS dev machine' \
  'remote deploy HOST                Fast-forward clean dotfiles and switch' \
  'remote status HOST                Check checkout, Tailscale and T3' \
  'remote connect HOST               Generate a one-time T3 pairing link' \
  'remote shell HOST                 Open an SSH shell' \
  'remote auth HOST gh               Independent GitHub login' \
  'remote auth HOST mcp executor     Independent MCP login (default: Pi)' \
  'remote auth HOST aws              Transfer cloud auth (also gcloud/azure/infisical/exa)' \
  'gclean / greset                   Clean merged branches / return to default branch'
