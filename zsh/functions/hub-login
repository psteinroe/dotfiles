# Add a Claude or Codex subscription account to CLIProxyAPI on the hub.
# Claude forwards the OAuth callback port to the hub and opens the authorize URL here.
# Codex uses a device code by default; --browser uses the OAuth callback flow instead.
# Usage: hub-login [--host host] claude | codex [--device|--browser]
local usage="Usage: hub-login [--host host] claude | codex [--device|--browser]"
local host="" provider="" mode=""
while (( $# )); do
  case "$1" in
    --host) host="${2:?--host needs a host}"; shift 2 ;;
    --device) mode=device; shift ;;
    --browser) mode=browser; shift ;;
    claude|codex) provider="$1"; shift ;;
    -h|--help) echo "$usage"; return 0 ;;
    *) echo "$usage" >&2; return 1 ;;
  esac
done
[[ -n "$provider" ]] || { echo "$usage" >&2; return 1; }

local dotfiles="${DOTFILES_DIR:-$HOME/Developer/dotfiles}"
source "$dotfiles/zsh/functions/_hub" || return
host="${host:-$hub_ssh}"

local login port pattern
if [[ "$provider" == claude ]]; then
  [[ "$mode" == device ]] && { echo "Claude has no device login; run hub-login claude" >&2; return 1; }
  login="cliproxy -claude-login -no-browser" port=54545
  pattern='https://[^[:space:]]+authorize\?[^[:space:]]+'
elif [[ "$mode" == browser ]]; then
  login="cliproxy -codex-login -no-browser" port=1455
  pattern='https://[^[:space:]]+authorize\?[^[:space:]]+'
else
  login="cliproxy -codex-device-login" port=""
  pattern='https://[^[:space:]]+'
fi

print -P "%F{yellow}Sign in with the ${(C)provider} account you want to ADD to the hub (check which account this browser is signed in to).%f"
[[ -n "$port" ]] && echo "The callback port $port is forwarded to $host; ignore the ssh -L instructions below."
[[ -z "$port" ]] && echo "Enter the device code printed below on the page that opens."

setopt local_options no_monitor no_notify
local log watcher
log=$(mktemp) || return
# Opens the first matching URL the login prints, and checks it calls back on the forwarded port
{
  local i link callback
  for i in {1..120}; do
    link=$(grep -o -E "$pattern" "$log" 2>/dev/null | head -n 1)
    if [[ -n "$link" ]]; then
      callback=$(print -r -- "$link" | grep -o -E 'redirect_uri=http%3A%2F%2F(localhost|127\.0\.0\.1)%3A[0-9]+' | grep -o -E '[0-9]+$')
      [[ -z "$port" || -z "$callback" || "$callback" == "$port" ]] ||
        echo "\nwarning: the login calls back on port $callback, but $port is forwarded" >&2
      if command -v open >/dev/null 2>&1; then open "$link"; else xdg-open "$link" >/dev/null 2>&1 || true; fi
      break
    fi
    sleep 1
  done
} &
watcher=$!

{
  # A terminal on the hub keeps the login's "paste the callback URL" fallback usable
  if [[ -n "$port" ]]; then
    ssh -t -o ExitOnForwardFailure=yes -o ControlMaster=no -o ControlPath=none \
      -L "$port:127.0.0.1:$port" "$host" "$login" | tee "$log"
  else
    ssh -t "$host" "$login" | tee "$log"
  fi
  (( ! pipestatus[1] ))
} always {
  kill "$watcher" 2>/dev/null
  rm -f "$log"
}
