# Prepare/register a remote Herdr session over the primary SSH target, then return.
# Usage: rdev <repo> [worktree|branch|pr-number]
if [[ $# -lt 1 || $# -gt 2 ]]; then
  echo "Usage: rdev <repo> [worktree|branch|pr-number]" >&2
  return 1
fi

local host="${RDEV_HOST:-rdev}"
local repo="${1%.git}"
local requested="${2:-}"
local remote_user="${RDEV_REMOTE_USER:-psteinroe}"
local remote_home="${RDEV_HOME:-/home/${remote_user}}"
local remote_path="${remote_home}/.local/bin:/etc/profiles/per-user/${remote_user}/bin:${remote_home}/.nix-profile/bin:/run/current-system/sw/bin:/nix/var/nix/profiles/default/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
# RDEV_DOTFILES belongs to commands executing on the target. Keep the local
# override separate so a local hprepare invocation cannot leak a Mac path here.
local dotfiles="${RDEV_REMOTE_DOTFILES:-${remote_home}/Developer/dotfiles}"

local local_dotfiles="${LOCAL_DOTFILES:-$HOME/Developer/dotfiles}"
source "$local_dotfiles/zsh/functions/_herdr_binary" || return
source "$local_dotfiles/zsh/functions/_herdr_machine_helpers" || return
local herdr_bin
herdr_bin="$(_herdr_binary)" || return
source "$local_dotfiles/zsh/functions/_rdev_title_helpers" 2>/dev/null || true
if (( $+functions[_rdev_set_repo_worktree_title] )); then
  _rdev_set_repo_worktree_title "$repo" "${requested:-herdr}"
fi

local prepare_cmd="
export PATH=${(q)remote_path}
export RDEV_DOTFILES=${(q)dotfiles}
_hprepare() { source ${(q)dotfiles}/zsh/functions/hprepare \"\$@\"; }
_hprepare ${(q)repo} ${(q)requested}
"
local encoded runner
encoded=$(printf '%s' "$prepare_cmd" | base64 | tr -d '\n') || return
runner="encoded=${(q)encoded}; cmd=\$(printf %s \"\$encoded\" | base64 -d); export HOME=${(q)remote_home} USER=${(q)remote_user} LOGNAME=${(q)remote_user} PATH=${(q)remote_path}; zsh_bin=\$(command -v zsh) || exit 127; \"\$zsh_bin\" -lc \"\$cmd\""

ssh -T "$host" "$runner" || return

# hprepare starts the named remote server. Register it only after preparation
# succeeds so a failed remote operation cannot mutate the local client.
_herdr_machine_register "$host" "$repo" "$herdr_bin" || return
local selected_label="$HERDR_MACHINE_LABEL"
print -r -- "Remote session '$repo' is ready in your existing Herdr client (saved profile: $selected_label)."
