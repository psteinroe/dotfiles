# Deploy the Raspberry Pi hub: runs the hub-deploy workflow on main, which builds on
# GitHub's ARM runners and switches the Pi. Nothing is built here or on the Pi.
# Usage: hub-rebuild [-h|--help]
local usage="Usage: hub-rebuild [-h|--help]"
case "$#:$1" in
  0:) ;;
  1:-h|1:--help) echo "$usage"; echo "Deploys committed main through GitHub Actions (hub-deploy)."; return 0 ;;
  *) echo "$usage" >&2; return 1 ;;
esac

echo "Deploy committed main through GitHub Actions; local edits are not deployed."
# command: the gh wrapper would pick GH_HOST from the current repo's origin
command gh workflow run hub-deploy.yml --repo psteinroe/dotfiles --ref main || return
echo "Follow it with: gh run list --repo psteinroe/dotfiles --workflow hub-deploy.yml"
