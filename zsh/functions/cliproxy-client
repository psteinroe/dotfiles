# Point a second Claude Code and Codex config (~/.claude-cliproxy, ~/.codex-cliproxy) at the
# cliproxy Pi, here or on a remote.
# The normal ~/.claude and ~/.codex logins stay untouched; use them via claude-cliproxy and codex-cliproxy.
# The access key comes from this Mac's Keychain (CLIPROXY_ACCESS_KEY) and is never printed. Fetch it once:
#   ssh psteinroe@cliproxy-psteinroe.tail649856.ts.net sudo cat /var/lib/cliproxyapi/access-key
#   set-keychain-environment-variable CLIPROXY_ACCESS_KEY    # paste it at the hidden prompt
# Usage: cliproxy-client [--host host]
local usage="Usage: cliproxy-client [--host host]"
local host=""
while (( $# )); do
  case "$1" in
    --host) host="${2:?--host needs a host}"; shift 2 ;;
    -h|--help) echo "$usage"; return 0 ;;
    *) echo "$usage" >&2; return 1 ;;
  esac
done

local dotfiles="${DOTFILES_DIR:-$HOME/Developer/dotfiles}"
source "$dotfiles/zsh/functions/_cliproxy" || return
(( $+functions[keychain-environment-variable] )) ||
  autoload -Uz "$dotfiles/zsh/functions/keychain-environment-variable"
local key
key=$(keychain-environment-variable CLIPROXY_ACCESS_KEY 2>/dev/null)
if [[ -z "$key" ]]; then
  echo "No CLIPROXY_ACCESS_KEY in the Keychain. Fetch it from the cliproxy Pi once:" >&2
  echo "  ssh $cliproxy_ssh sudo cat /var/lib/cliproxyapi/access-key" >&2
  echo "  set-keychain-environment-variable CLIPROXY_ACCESS_KEY" >&2
  return 1
fi

# Reads the key from stdin and passes it on only through builtins and the environment,
# never in a command's arguments. Existing files are backed up, then merged.
local script='set -eu
IFS= read -r CLIPROXY_KEY
export CLIPROXY_KEY
url='"${(qq)cliproxy_url}"'
umask 077
stamp=$(date +%Y%m%d%H%M%S)
mkdir -p "$HOME/.claude-cliproxy" "$HOME/.codex-cliproxy"

settings="$HOME/.claude-cliproxy/settings.json"
if [ -s "$settings" ]; then cp "$settings" "$settings.bak-$stamp"; else echo "{}" >"$settings"; fi
CLIPROXY_URL="$url" jq ".env = ((.env // {}) + {ANTHROPIC_BASE_URL: env.CLIPROXY_URL, ANTHROPIC_AUTH_TOKEN: env.CLIPROXY_KEY})" \
  "$settings" >"$settings.tmp"
mv "$settings.tmp" "$settings"

config="$HOME/.codex-cliproxy/config.toml"
if [ -s "$config" ]; then cp "$config" "$config.bak-$stamp"; else : >"$config"; fi
{
  printf "model_provider = \"cliproxy\"\n"
  # Drops the old top-level model_provider and [model_providers.cliproxy] table, keeps the rest
  awk "/^[[:space:]]*\\[/ { table = 1; skip = (\$0 ~ /^[[:space:]]*\\[model_providers\\.cliproxy\\][[:space:]]*\$/) }
    !table && /^[[:space:]]*model_provider[[:space:]]*=/ { next }
    skip { next }
    { print }" "$config"
  printf "\n[model_providers.cliproxy]\nname = \"CLIProxyAPI\"\nbase_url = \"%s/v1\"\nwire_api = \"responses\"\nrequires_openai_auth = false\nsupports_websockets = true\nexperimental_bearer_token = \"%s\"\n" "$url" "$CLIPROXY_KEY"
} >"$config.tmp"
mv "$config.tmp" "$config"
echo "Wrote $settings and $config"

if body=$(printf "Authorization: Bearer %s\n" "$CLIPROXY_KEY" | curl -fsS -H @- "$url/v1/models") &&
  models=$(printf "%s" "$body" | jq -e ".data | length"); then
  echo "The cliproxy Pi serves $models models"
else
  echo "warning: could not list models at $url/v1/models" >&2
fi'

if [[ -n "$host" ]]; then
  print -r -- "$key" | ssh -o ControlMaster=no -o ControlPath=none "$host" "exec \"\$SHELL\" -lc ${(qq)script}"
else
  print -r -- "$key" | sh -c "$script"
fi
