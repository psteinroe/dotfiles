# Sync Herdr workspaces with existing Git worktrees for the current repo.
# Usage: hsyncworktrees [--prune|--prune-only]
#
# The default is the explicit, full sync escape hatch: expose every existing Git
# worktree as a Herdr workspace. --prune keeps that behavior and then closes
# stale workspaces. --prune-only only closes stale/missing Herdr workspaces and
# never creates or focuses anything. None of these modes deletes Git worktrees.
if [[ $# -gt 1 || ( $# -eq 1 && "$1" != "--prune" && "$1" != "--prune-only" ) ]]; then
  echo "Usage: hsyncworktrees [--prune|--prune-only]" >&2
  return 1
fi

local dotfiles="${RDEV_DOTFILES:-$HOME/Developer/dotfiles}"
source "$dotfiles/zsh/functions/_herdr_worktree_helpers" || return

_h_require_herdr || return
_h_repo_context || return

local prune=0
local prune_only=0
[[ "${1:-}" == "--prune" ]] && prune=1
[[ "${1:-}" == "--prune-only" ]] && prune_only=1

if (( prune_only )); then
  _h_prune_missing_workspaces
  return $?
fi

local wt_path label
while IFS= read -r wt_path; do
  [[ -n "$wt_path" && -d "$wt_path" ]] || continue
  label="$(_h_worktree_label "$wt_path")"
  _h_ensure_workspace "$wt_path" "$label" 0 || return
done < <(_h_git_worktree_paths)

if (( prune )); then
  _h_prune_missing_workspaces
fi
